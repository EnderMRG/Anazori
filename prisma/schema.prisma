generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Campus {
  id          String   @id @default(cuid())
  name        String   @unique
  city        String   @default("Campus network")
  description String   @default("A connected space for the campus community.")
  accent      String   @default("#2b8f85")
  createdAt   DateTime @default(now())
}

model User {
  id                String      @id @default(cuid())
  name              String
  email             String      @unique
  passwordHash      String
  role              String      @default("student")
  campusName        String      @default("Dibrugarh University")
  preferredLanguage String      @default("en")
  createdAt         DateTime    @default(now())
  complaints        Complaint[]
  notifications     Notification[]
}

model Complaint {
  id          String   @id @default(cuid())
  publicId    String   @unique
  userId      String
  campusName  String
  title       String
  description String
  language    String   @default("en")
  category    String
  priority    String
  department  String
  status      String   @default("Submitted")
  location    String
  latitude    Float?
  longitude   Float?
  imageUrl    String?
  resolvedImageUrl String?
  resolutionNotes  String?
  summaryEn   String
  summaryAs   String
  tags        String[] @default([])
  upvotes     Int      @default(1)
  masterId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  master      Complaint? @relation("ComplaintDuplicates", fields: [masterId], references: [id], onDelete: SetNull)
  duplicates  Complaint[] @relation("ComplaintDuplicates")
  notifications Notification[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([campusName, status])
  @@index([campusName, createdAt, id])
  @@index([masterId])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  title       String
  body        String
  read        Boolean   @default(false)
  complaintId String?
  complaint   Complaint? @relation(fields: [complaintId], references: [id], onDelete: SetNull)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([userId, read, createdAt])
}
